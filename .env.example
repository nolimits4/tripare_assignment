# Copy to .env to override the local database defaults.
# docker-compose.yml and the scripts in scripts/ both read these.

POSTGRES_DB=hotelapp
POSTGRES_USER=hotelapp
POSTGRES_PASSWORD=hotelapp_local_pw

# Host port the database is published on. Change it if 5432 is already taken.
POSTGRES_PORT=5432

# Database that restore.sh creates. Defaults to <POSTGRES_DB>_restored.
# RESTORE_DB=hotelapp_restored

# Where dumps are written. Defaults to ./backups.
# BACKUP_DIR=./backups
